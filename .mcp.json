{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-cbeaba35-419c-4bc1-bd90-3830b9cbba21"
      }
    },

    "sec_edgar_mcp": {
      "command": "/home/help/miniconda3/envs/aiquantlab/bin/python",
      "args": ["-m", "sec_edgar_mcp.server"],
      "env": {
        "SEC_EDGAR_USER_AGENT": "yuye zhang (zhangyuye555@gmail.com)",
        "SEC_EDGAR_RATE_LIMIT": "8",
        "SEC_EDGAR_TIMEOUT": "60"
      }
    },

    "fs": {
      "command": "/home/help/mcp/tools/bin/npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/help/mcp/work"]
    },

    "fetch": {
      "command": "/home/help/.venvs/mcp-fetch/bin/python",
      "args": [
        "-m",
        "mcp_server_fetch",
        "--user-agent=yuye zhang zhangyuye555@gmail.com",
        "--ignore-robots-txt"
      ]
    },

    "alpaca": {
      "command": "/home/help/mcp/servers/alpaca-mcp-server/.venv/bin/alpaca-mcp-server",
      "args": ["serve"],
      "cwd": "/home/help/mcp/servers/alpaca-mcp-server",
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY}",
        "ALPACA_SECRET_KEY": "${ALPACA_SECRET_KEY}",
        "ALPACA_PAPER_TRADE": "${ALPACA_PAPER_TRADE:-True}"
      }
    },

    "rss": {
      "command": "/home/help/mcp/tools/node/bin/node",
      "args": ["/home/help/mcp/servers/rss-mcp/dist/index.js"]
    },

    "gdelt": {
      "command": "/home/help/mcp/tools/node/bin/node",
      "args": ["/home/help/mcp/servers/GDELT-mcp/dist/index.js"],
      "cwd": "/home/help/mcp/servers/GDELT-mcp",
      "env": {
        "GDELT_USER_AGENT": "yuye zhang (zhangyuye555@gmail.com) gdelt-mcp",
        "GDELT_API_TIMEOUT": "60000",
        "LOG_LEVEL": "info"
      }
    },

    "trading_mcp": {
      "command": "/home/help/mcp/tools/node/bin/node",
      "args": ["/home/help/mcp/servers/trading-mcp/dist/bootstrap.js"],
      "cwd": "/home/help/mcp/servers/trading-mcp",
      "env": {
        "NODE_OPTIONS": "--trace-uncaught --trace-warnings --unhandled-rejections=strict"
      }
    },

    "search": {
      "command": "/home/help/.venvs/mcp-search/bin/mcp-search-server",
      "cwd": "/home/help/mcp/servers/mcp-search-server"
    },

    "openalex": {
      "command": "/home/help/mcp/tools/node/bin/node",
      "args": ["/home/help/mcp/servers/openalex-research-mcp/build/index.js"],
      "cwd": "/home/help/mcp/servers/openalex-research-mcp",
      "env": {
        "OPENALEX_EMAIL": "zhangyuye555@gmail.com"
      }
    },

    "crossref": {
      "command": "/home/help/mcp/tools/bin/npx",
      "args": ["-y", "@botanicastudios/crossref-mcp"]
    },

    "pubmed": {
      "command": "/home/help/.venvs/pubmed-mcp/bin/python",
      "args": ["/home/help/mcp/servers/pubmed-mcp/pubmed_server.py"],
      "cwd": "/home/help/mcp/servers/pubmed-mcp"
    },

    "arxiv": {
      "command": "/home/help/mcp/tools/uv/uv",
      "args": [
        "tool",
        "run",
        "arxiv-mcp-server",
        "--storage-path",
        "/home/help/mcp/data/arxiv_papers"
      ],
      "env": {
        "PYMUPDF_SUGGEST_LAYOUT_ANALYZER": "0"
      }
    },

    "yfinance": {
      "command": "/home/help/mcp/tools/uv/uv",
      "args": ["--directory", "/home/help/mcp/servers/yahoo-finance-mcp", "run", "server.py"],
      "cwd": "/home/help/mcp/servers/yahoo-finance-mcp"
    },

    "github": {
      "command": "/home/help/mcp/tools/bin/npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },

    "git": {
      "command": "/home/help/.venvs/mcp-git/bin/python",
      "args": ["-m", "mcp_server_git", "--repository", "/mnt/d/python_project/my-quant-project"]
    },

    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}
