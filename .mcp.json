    },
    "search": {
      "command": "/home/help/.venvs/mcp-search/bin/mcp-search-server",
      "cwd": "/home/help/mcp/servers/mcp-search-server"
    },
    "openalex": {
      "command": "/home/help/mcp/tools/node/bin/node",
