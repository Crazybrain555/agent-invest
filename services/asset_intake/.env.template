# asset_intake service environment template.
#
# Keep real credentials out of repo files. Put local secrets in your shell,
# Keychain, or a private env file outside this checkout.

ASSET_INTAKE_DATA_ROOT=/Volumes/AgentSSD/agent_system/services/asset_intake

# Shared cluster (AgentSSD pg18-main), database invest_engine, intake_* roles.
# Use a private password/env override for local development. Do not commit it.
ASSET_INTAKE_DATABASE_URL=postgresql+psycopg://intake_app:<set-in-private-env>@127.0.0.1:55432/invest_engine
ASSET_INTAKE_MIGRATION_DATABASE_URL=postgresql+psycopg://intake_owner:<set-in-private-env>@127.0.0.1:55432/invest_engine
ASSET_INTAKE_READER_DATABASE_URL=postgresql+psycopg://intake_reader:<set-in-private-env>@127.0.0.1:55432/invest_engine

# Provider credentials (P3+). Leave unset until needed; tests use fixtures.
TUSHARE_TOKEN=<set-in-private-env>
