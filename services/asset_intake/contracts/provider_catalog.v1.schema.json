        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "required_columns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Columns",
          "type": "array"
