      ],
      "text_level": 2,
      "page_no": 2,
      "text": "第一节 重要提示、目录和释义",
      "document_id": "phase00_annual_report_excerpt"
    },
    {
      "ir_id": "annual_report_excerpt_ir_0007",
      "kind": "text",
