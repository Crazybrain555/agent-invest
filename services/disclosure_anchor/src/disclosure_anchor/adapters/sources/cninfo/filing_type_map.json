{
  "version": "2026-07-r5",
  "rules": [
    {
      "filing_type": "intermediary_report",
      "keywords": [
        "法律意见书",
        "核查意见",
        "受托管理事务报告",
        "跟踪评级",
        "验资报告",
        "持续督导",
        "独立财务顾问报告"
      ],
      "match": "any"
    },
    {
      "filing_type": "semiannual_report",
      "keywords": [
        "半年度报告"
      ],
      "match": "any"
    },
    {
      "filing_type": "quarterly_report",
      "keywords": [
        "季度报告"
      ],
      "match": "any"
    },
    {
      "filing_type": "annual_report",
      "keywords": [
        "年度报告"
      ],
      "match": "any"
    },
    {
      "filing_type": "performance_forecast",
      "keywords": [
        "业绩预告"
      ],
      "match": "any"
    },
    {
      "filing_type": "performance_flash",
      "keywords": [
        "业绩快报"
      ],
      "match": "any"
    },
    {
      "filing_type": "investor_relations",
      "keywords": [
        "投资者关系",
        "调研活动"
      ],
      "match": "any"
    },
    {
      "filing_type": "performance_briefing",
      "keywords": [
        "说明会"
      ],
      "match": "any"
    },
    {
      "filing_type": "inquiry_regulatory",
      "keywords": [
        "问询",
        "回复"
      ],
      "match": "all"
    }
  ],
  "topic_rules": [
    {
      "class": "operating_data",
      "keywords": [
        "销售简报",
        "情况简报",
        "经营数据",
        "发电量完成情况",
        "生产经营情况"
      ]
    }
  ],
  "_about": "标题/分类名关键词规则（唯一用途：无码通道的视图现算 title 规则 + 注册期 report_period 推导的临时输入；0017 起不再持久化任何 filing_type 列）。rules 顺序即优先级：intermediary_report 必须最前（carrier 载体判定优先于主题词——'股权激励法律意见书'是法律意见书不是激励公告）；semiannual 必须在 annual 之前（子串遮蔽）。topic_rules（2026-07-r5，rule_set=title_topic）：无论有码无码都追加命中的 class（补 provider 码盲区——巨潮把销售简报/经营数据/发电量编成 012305 经营环境重大变化，010309 从不出现；见 docs/agent/notes/process-classes-review-2026-07-12.md F3）；值域 ⊆ class_map.json 类名，priority 取 class_map 类优先级。"
}
