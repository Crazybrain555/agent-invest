          "minimum": 0,
          "title": "Pages",
          "type": "integer"
        }
      },
      "required": [
        "documents",
        "pages"
      ],
      "title": "M6Drain",
      "type": "object"
    },
    "M6EvidenceInput": {
      "additionalProperties": false,
      "description": "One immutable file the report was derived from, by the exact bytes read.",
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "M6EvidenceInput",
      "type": "object"
    },
    "M6LatencyBySize": {
      "additionalProperties": false,
      "properties": {
        "classes": {
          "$ref": "#/$defs/M6LatencyClasses"
        },
        "clocks": {
          "$ref": "#/$defs/M6LatencyClocks",
          "default": {
            "owner": "owner_qpc_received_ticks",
            "stage": "mac_monotonic_ns"
          }
        },
        "gates": {
          "$ref": "#/$defs/M6LatencyGateResult"
        },
        "stage_timing": {
          "$ref": "#/$defs/M6StageTiming"
        }
      },
      "required": [
        "classes",
        "stage_timing",
        "gates"
      ],
      "title": "M6LatencyBySize",
      "type": "object"
    },
    "M6LatencyClass": {
      "additionalProperties": false,
      "description": "One size class: owner-tick measures, plus the stage-clock remote/public measures.\n\nThe owner measures are stamped by the physical owner; the stage measures are\nstamped by the Mac runner and verifier processes. The two clocks are never\nmixed inside one measure, and `remote_samples`/`public_samples` say how many\nattempts actually produced each stage measure.",
      "properties": {
        "admission_to_public_confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6LatencyMeasure"
            },
            {
              "type": "null"
            }
          ]
        },
        "admission_to_remote_accepted": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6LatencyMeasure"
            },
            {
              "type": "null"
            }
          ]
        },
        "n": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "public_samples": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Public Samples",
          "type": "integer"
        },
        "publication_committed_to_public_confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6LatencyMeasure"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote_accepted_to_publication_committed": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6LatencyMeasure"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote_post_to_terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6LatencyMeasure"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote_resends": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Remote Resends",
          "type": "integer"
        },
        "remote_samples": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Remote Samples",
          "type": "integer"
        },
        "remote_terminal_failures": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Remote Terminal Failures",
          "type": "integer"
        },
        "terminal_to_public_confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6LatencyMeasure"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "n",
        "admission_to_remote_accepted",
        "remote_accepted_to_publication_committed",
        "publication_committed_to_public_confirmation",
        "admission_to_public_confirmation",
        "remote_post_to_terminal",
        "terminal_to_public_confirmation",
        "remote_samples",
        "public_samples",
        "remote_resends",
        "remote_terminal_failures"
      ],
      "title": "M6LatencyClass",
      "type": "object"
    },
