          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Documents",
          "type": "integer"
        },
        "documents_per_hour": {
          "maximum": 1000000000000000.0,
          "minimum": 0.0,
          "title": "Documents Per Hour",
