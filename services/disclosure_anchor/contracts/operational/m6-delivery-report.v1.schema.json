      "type": "object"
    },
    "M6Drain": {
      "additionalProperties": false,
      "description": "Credit that closed after the admission deadline: whole-run only, never the main window.",
      "properties": {
        "documents": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Documents",
          "type": "integer"
        },
        "pages": {
