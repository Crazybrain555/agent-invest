{
  "$defs": {
    "M6BusinessObligationsClosed": {
      "additionalProperties": false,
      "description": "Every claimed obligation's final disposition, its ACK/absence proof and the external exits.",
      "properties": {
        "ack_or_absence_proven": {
          "title": "Ack Or Absence Proven",
          "type": "boolean"
        },
        "admission_reconciled": {
          "title": "Admission Reconciled",
          "type": "boolean"
        },
        "admitted_attempts": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Admitted Attempts",
          "type": "integer"
        },
        "all_closed": {
          "title": "All Closed",
          "type": "boolean"
        },
        "attempts_without_final": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x20\\x7f]+$",
            "type": "string"
          },
          "maxItems": 100000,
          "title": "Attempts Without Final",
          "type": "array"
        },
        "external_owner_exit_verified": {
          "title": "External Owner Exit Verified",
          "type": "boolean"
        },
        "final_attempts": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Final Attempts",
          "type": "integer"
        },
        "local_children_reaped": {
          "title": "Local Children Reaped",
          "type": "boolean"
        },
        "missing": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x20\\x7f]+$",
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Missing",
          "type": "array"
        },
        "ownership_closed": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6OwnershipClosed"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote_open": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x20\\x7f]+$",
            "type": "string"
          },
          "maxItems": 100000,
          "title": "Remote Open",
          "type": "array"
        },
        "run_closed_reason": {
          "anyOf": [
            {
              "enum": [
                "deadline_drained",
                "stop_requested",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Closed Reason"
        }
      },
      "required": [
        "all_closed",
        "admitted_attempts",
        "final_attempts",
        "attempts_without_final",
        "remote_open",
        "ack_or_absence_proven",
        "admission_reconciled",
        "ownership_closed",
        "run_closed_reason",
        "external_owner_exit_verified",
        "local_children_reaped",
        "missing"
      ],
      "title": "M6BusinessObligationsClosed",
      "type": "object"
    },
    "M6DeliveryEvidence": {
