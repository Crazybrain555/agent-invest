          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Pages",
          "type": "integer"
        },
        "pages_per_minute": {
          "maximum": 1000000000000000.0,
          "minimum": 0.0,
          "title": "Pages Per Minute",
          "type": "number"
        },
        "span_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Span Seconds",
          "type": "integer"
        },
        "start_ticks": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Start Ticks",
          "type": "integer"
        },
        "sub_windows": {
          "items": {
            "$ref": "#/$defs/M6SubWindow"
          },
