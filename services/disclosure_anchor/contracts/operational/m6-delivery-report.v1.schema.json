    "M6StageTiming": {
      "additionalProperties": false,
      "description": "Whether the Mac stage observation could time this run at all, and why not.\n\n`measured` requires a complete, lossless observation, one agreed monotonic\nclock binding across the runner and verifier processes, and at least one\nattempt whose remote episode was timed end to end.",
      "properties": {
        "attempts_measured": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Attempts Measured",
          "type": "integer"
        },
        "attempts_required": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Attempts Required",
          "type": "integer"
        },
        "clock_binding_sha256": {
          "anyOf": [
            {
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Clock Binding Sha256"
        },
        "notes_total": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Notes Total",
          "type": "integer"
        },
        "observation_status": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "partial",
                "invalid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observation Status"
        },
        "reasons": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x20\\x7f]+$",
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "enum": [
            "measured",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reasons",
        "observation_status",
        "clock_binding_sha256",
        "attempts_required",
        "attempts_measured",
        "notes_total"
      ],
      "title": "M6StageTiming",
      "type": "object"
    },
