    "contract_version": {
      "const": "mineru.synchronized-telemetry-seal.v2",
      "default": "mineru.synchronized-telemetry-seal.v2",
      "title": "Contract Version",
      "type": "string"
    },
    "frames_jsonl_sha256": {
      "title": "Frames Jsonl Sha256",
      "type": "string"
    },
    "maximum_observer_overhead_ratio": {
      "default": 0.02,
      "maximum": 0.02,
      "minimum": 0.02,
      "title": "Maximum Observer Overhead Ratio",
      "type": "number"
    },
    "preseal_observer_cpu_ns": {
      "minimum": 0,
      "title": "Preseal Observer Cpu Ns",
      "type": "integer"
    },
    "preseal_observer_process_cpu_finished_ns": {
      "minimum": 0,
      "title": "Preseal Observer Process Cpu Finished Ns",
      "type": "integer"
    },
    "preseal_observer_process_cpu_started_ns": {
      "minimum": 0,
      "title": "Preseal Observer Process Cpu Started Ns",
      "type": "integer"
    },
    "receipt_sha256": {
      "title": "Receipt Sha256",
      "type": "string"
    },
    "receipt_status": {
      "enum": [
        "complete",
        "incomplete",
        "unsafe"
      ],
      "title": "Receipt Status",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "sampling_elapsed_ns_denominator": {
      "exclusiveMinimum": 0,
      "title": "Sampling Elapsed Ns Denominator",
      "type": "integer"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "unsafe"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "receipt_sha256",
    "frames_jsonl_sha256",
    "preseal_observer_process_cpu_started_ns",
    "preseal_observer_process_cpu_finished_ns",
    "preseal_observer_cpu_ns",
