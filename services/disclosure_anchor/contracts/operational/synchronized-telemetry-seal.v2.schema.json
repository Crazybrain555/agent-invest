{
  "$id": "https://agent-invest.local/contracts/operational/synchronized-telemetry-seal.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Non-self-referential attestation created after mandatory receipt replay.",
