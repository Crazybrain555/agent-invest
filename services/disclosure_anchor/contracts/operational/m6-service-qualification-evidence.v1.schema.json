{
  "$defs": {
    "M6ReviewRecord": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "accept",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "evidence_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "observation_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "reason": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x20\\x7f]+$",
          "title": "Reason",
          "type": "string"
        },
        "reviewer_identity": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x20\\x7f]+$",
          "title": "Reviewer Identity",
          "type": "string"
        }
      },
      "required": [
        "observation_sha256",
        "reason",
        "reviewer_identity",
        "decision",
        "evidence_sha256"
      ],
      "title": "M6ReviewRecord",
      "type": "object"
    },
    "M6ServiceCheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "enum": [
            "provider_artifact_closure",
            "provider_content_integrity",
            "provider_page_closure",
            "source_identity"
          ],
          "title": "Check Id",
          "type": "string"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Sha256"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "unverified"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "outcome",
        "evidence_sha256"
      ],
      "title": "M6ServiceCheckResult",
      "type": "object"
    },
    "M6ServiceQualificationObservation": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x20\\x7f]+$",
          "title": "Attempt Id",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/M6ServiceCheckResult"
          },
          "maxItems": 4,
          "title": "Checks",
          "type": "array"
        },
        "mode": {
          "const": "service_diagnostic",
          "title": "Mode",
          "type": "string"
        },
        "output_sealed_record_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Sealed Record Sha256",
          "type": "string"
        },
        "parser_target_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parser Target Sha256",
          "type": "string"
        },
        "provider_bundle_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Provider Bundle Sha256",
          "type": "string"
        },
        "provider_page_count": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Provider Page Count",
          "type": "integer"
        },
        "quality_verifier_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Quality Verifier Sha256",
          "type": "string"
        },
        "review_reasons": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x20\\x7f]+$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Review Reasons",
          "type": "array"
        },
        "source_byte_count": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Source Byte Count",
          "type": "integer"
        },
        "source_observed_record_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Observed Record Sha256",
          "type": "string"
        },
        "source_page_count": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Source Page Count",
          "type": "integer"
        },
        "source_pdf_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Pdf Sha256",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "attempt_id",
        "source_pdf_sha256",
        "source_byte_count",
        "source_page_count",
        "provider_page_count",
        "provider_bundle_sha256",
        "parser_target_sha256",
        "quality_verifier_sha256",
        "source_observed_record_sha256",
        "output_sealed_record_sha256",
        "review_reasons",
        "checks"
      ],
      "title": "M6ServiceQualificationObservation",
      "type": "object"
    }
  },
  "$id": "urn:disclosure-anchor:operational:m6-service-qualification-evidence.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "m6.service-qualification-evidence.v1",
      "default": "m6.service-qualification-evidence.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "observation": {
      "$ref": "#/$defs/M6ServiceQualificationObservation"
    },
    "reviews": {
      "items": {
        "$ref": "#/$defs/M6ReviewRecord"
      },
      "maxItems": 256,
      "title": "Reviews",
      "type": "array"
    }
  },
  "required": [
    "observation",
    "reviews"
  ],
  "title": "M6ServiceQualificationEvidence",
  "type": "object"
}
