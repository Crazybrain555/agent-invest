{
  "$defs": {
    "CapacityVector": {
      "additionalProperties": false,
      "properties": {
        "document_owner_bytes": {
          "minimum": 0,
          "title": "Document Owner Bytes",
          "type": "integer"
        },
        "model_cpu_bytes": {
          "minimum": 0,
          "title": "Model Cpu Bytes",
          "type": "integer"
        },
        "model_gpu_bytes": {
          "minimum": 0,
          "title": "Model Gpu Bytes",
          "type": "integer"
        },
        "native_owner_slots": {
          "minimum": 0,
          "title": "Native Owner Slots",
          "type": "integer"
        },
        "raster_cpu_bytes": {
          "minimum": 0,
          "title": "Raster Cpu Bytes",
          "type": "integer"
        },
        "source_disk_bytes": {
          "minimum": 0,
          "title": "Source Disk Bytes",
          "type": "integer"
        },
        "task_slots": {
          "minimum": 0,
          "title": "Task Slots",
          "type": "integer"
        },
        "tensor_cpu_bytes": {
          "minimum": 0,
          "title": "Tensor Cpu Bytes",
          "type": "integer"
        },
        "tensor_gpu_bytes": {
          "minimum": 0,
          "title": "Tensor Gpu Bytes",
          "type": "integer"
        },
        "vllm_sequence_slots": {
          "minimum": 0,
          "title": "Vllm Sequence Slots",
          "type": "integer"
        }
      },
      "required": [
        "source_disk_bytes",
        "raster_cpu_bytes",
        "tensor_cpu_bytes",
        "tensor_gpu_bytes",
        "model_cpu_bytes",
        "model_gpu_bytes",
        "document_owner_bytes",
        "task_slots",
        "native_owner_slots",
        "vllm_sequence_slots"
      ],
      "title": "CapacityVector",
      "type": "object"
    },
    "LaneQualitySummary": {
      "additionalProperties": false,
      "properties": {
        "lane": {
          "enum": [
            "gpu_fast",
            "host_slow"
          ],
          "title": "Lane",
          "type": "string"
        },
        "late_sample_count": {
          "minimum": 0,
          "title": "Late Sample Count",
          "type": "integer"
        },
        "maximum_gap_ms": {
          "minimum": 0,
          "title": "Maximum Gap Ms",
          "type": "number"
        },
        "missed_deadline_count": {
          "minimum": 0,
          "title": "Missed Deadline Count",
          "type": "integer"
        },
        "nominal_interval_ms": {
          "maximum": 1000,
          "minimum": 250,
          "title": "Nominal Interval Ms",
          "type": "integer"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "supported_frame_count": {
          "minimum": 0,
          "title": "Supported Frame Count",
          "type": "integer"
        }
      },
      "required": [
        "lane",
        "nominal_interval_ms",
        "sample_count",
        "maximum_gap_ms",
        "late_sample_count",
        "missed_deadline_count",
        "supported_frame_count"
      ],
      "title": "LaneQualitySummary",
      "type": "object"
    },
    "MeasuredSafetyMargin": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "$ref": "#/$defs/CapacityVector"
        },
        "method": {
          "const": "p99-mad-positive-jump.v1",
          "default": "p99-mad-positive-jump.v1",
          "title": "Method",
          "type": "string"
        },
        "model_baseline": {
          "$ref": "#/$defs/CapacityVector"
        },
        "safety_margin": {
          "$ref": "#/$defs/CapacityVector"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "uncertainty": {
          "$ref": "#/$defs/CapacityVector"
        }
      },
      "required": [
        "sample_count",
        "capacity",
        "model_baseline",
        "uncertainty",
        "safety_margin"
      ],
      "title": "MeasuredSafetyMargin",
      "type": "object"
    },
    "ProcessProfileLifecycle": {
      "additionalProperties": false,
      "properties": {
        "clock_domain_identity_sha256": {
          "title": "Clock Domain Identity Sha256",
          "type": "string"
        },
        "lifecycle": {
          "const": "startup_only",
          "default": "startup_only",
          "title": "Lifecycle",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/ProcessProfileParameters"
        },
        "process_epoch_sha256": {
          "title": "Process Epoch Sha256",
          "type": "string"
        },
        "process_profile_sha256": {
          "title": "Process Profile Sha256",
          "type": "string"
        },
        "runtime_bundle_identity_sha256": {
          "title": "Runtime Bundle Identity Sha256",
          "type": "string"
        },
        "started_at_utc": {
          "format": "date-time",
          "title": "Started At Utc",
          "type": "string"
        },
        "started_monotonic_ns": {
          "minimum": 0,
          "title": "Started Monotonic Ns",
          "type": "integer"
        }
      },
      "required": [
        "runtime_bundle_identity_sha256",
        "process_epoch_sha256",
        "process_profile_sha256",
        "clock_domain_identity_sha256",
        "started_at_utc",
        "started_monotonic_ns",
        "parameters"
      ],
      "title": "ProcessProfileLifecycle",
      "type": "object"
    },
    "ProcessProfileParameters": {
      "additionalProperties": false,
      "properties": {
        "api_max_pending_tasks": {
          "minimum": 1,
          "title": "Api Max Pending Tasks",
          "type": "integer"
        },
        "api_task_slots": {
          "minimum": 1,
          "title": "Api Task Slots",
          "type": "integer"
        },
        "effective_hybrid_batch_ratio": {
          "minimum": 1,
          "title": "Effective Hybrid Batch Ratio",
          "type": "integer"
        },
        "inference_concurrency": {
          "minimum": 1,
          "title": "Inference Concurrency",
          "type": "integer"
        },
        "processing_window_size": {
          "minimum": 1,
          "title": "Processing Window Size",
          "type": "integer"
        },
        "requested_hybrid_batch_ratio": {
          "minimum": 1,
          "title": "Requested Hybrid Batch Ratio",
          "type": "integer"
        },
        "vllm_max_num_seqs": {
          "minimum": 1,
          "title": "Vllm Max Num Seqs",
          "type": "integer"
        }
      },
      "required": [
        "requested_hybrid_batch_ratio",
        "effective_hybrid_batch_ratio",
        "api_task_slots",
        "api_max_pending_tasks",
        "inference_concurrency",
        "processing_window_size",
        "vllm_max_num_seqs"
      ],
      "title": "ProcessProfileParameters",
      "type": "object"
    },
    "TelemetryArtifacts": {
      "additionalProperties": false,
      "properties": {
        "frames_sha256": {
          "title": "Frames Sha256",
          "type": "string"
        },
        "phase_capture_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase Capture Sha256"
        },
        "phase_clock_binding_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase Clock Binding Sha256"
        },
        "progress_events_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Progress Events Sha256"
        },
        "vector_events_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vector Events Sha256"
        }
      },
      "required": [
        "frames_sha256",
        "progress_events_sha256",
        "vector_events_sha256"
      ],
      "title": "TelemetryArtifacts",
      "type": "object"
    }
  },
  "$id": "https://agent-invest.local/contracts/operational/synchronized-telemetry-receipt.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_authorized": {
      "const": false,
      "default": false,
      "title": "Activation Authorized",
      "type": "boolean"
    },
    "artifacts": {
      "$ref": "#/$defs/TelemetryArtifacts"
    },
    "clock_domain_identity_sha256": {
      "title": "Clock Domain Identity Sha256",
      "type": "string"
    },
    "contract_version": {
      "const": "mineru.synchronized-telemetry-receipt.v1",
      "default": "mineru.synchronized-telemetry-receipt.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "epoch_changed": {
      "title": "Epoch Changed",
      "type": "boolean"
    },
    "finished_at_utc": {
      "format": "date-time",
      "title": "Finished At Utc",
      "type": "string"
    },
    "finished_monotonic_ns": {
      "minimum": 0,
      "title": "Finished Monotonic Ns",
      "type": "integer"
    },
    "lane_quality": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/LaneQualitySummary"
        },
        {
          "$ref": "#/$defs/LaneQualitySummary"
        }
      ],
      "title": "Lane Quality",
      "type": "array"
    },
    "maximum_clock_divergence_fixed_ns": {
      "const": 50000000,
      "default": 50000000,
      "title": "Maximum Clock Divergence Fixed Ns",
      "type": "integer"
    },
    "maximum_clock_divergence_ppm": {
      "const": 50,
      "default": 50,
      "title": "Maximum Clock Divergence Ppm",
      "type": "integer"
    },
    "maximum_observer_overhead_ratio": {
      "default": 0.02,
      "maximum": 0.02,
      "minimum": 0.02,
      "title": "Maximum Observer Overhead Ratio",
      "type": "number"
    },
    "observed_clock_divergence_ns": {
      "minimum": 0,
      "title": "Observed Clock Divergence Ns",
      "type": "integer"
    },
    "observer_cpu_ns": {
      "minimum": 0,
      "title": "Observer Cpu Ns",
      "type": "integer"
    },
    "observer_process_cpu_finished_ns": {
      "minimum": 0,
      "title": "Observer Process Cpu Finished Ns",
      "type": "integer"
    },
    "observer_process_cpu_started_ns": {
      "minimum": 0,
      "title": "Observer Process Cpu Started Ns",
      "type": "integer"
    },
    "observer_source_sha256": {
      "title": "Observer Source Sha256",
      "type": "string"
    },
    "process_profile": {
      "$ref": "#/$defs/ProcessProfileLifecycle"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "runtime_bundle_identity_sha256": {
      "title": "Runtime Bundle Identity Sha256",
      "type": "string"
    },
    "safety_margin": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeasuredSafetyMargin"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at_utc": {
      "format": "date-time",
      "title": "Started At Utc",
      "type": "string"
    },
    "started_monotonic_ns": {
      "minimum": 0,
      "title": "Started Monotonic Ns",
      "type": "integer"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "unsafe"
      ],
      "title": "Status",
      "type": "string"
    },
    "termination_reason": {
      "enum": [
        "duration_elapsed",
        "cancelled",
        "sampler_or_transport_shutdown",
        "queue_overflow",
        "artifact_bound_exceeded",
        "identity_drift"
      ],
      "title": "Termination Reason",
      "type": "string"
    },
    "unsupported_observation_count": {
      "minimum": 0,
      "title": "Unsupported Observation Count",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "runtime_bundle_identity_sha256",
    "process_profile",
    "observer_source_sha256",
    "clock_domain_identity_sha256",
    "started_at_utc",
    "finished_at_utc",
    "started_monotonic_ns",
    "finished_monotonic_ns",
    "status",
    "lane_quality",
    "termination_reason",
    "observer_process_cpu_started_ns",
    "observer_process_cpu_finished_ns",
    "observer_cpu_ns",
    "observed_clock_divergence_ns",
    "epoch_changed",
    "unsupported_observation_count",
    "safety_margin",
    "artifacts"
  ],
  "title": "SynchronizedTelemetryReceipt",
  "type": "object"
}
