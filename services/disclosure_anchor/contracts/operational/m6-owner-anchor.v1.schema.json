{
  "$defs": {
    "M6ClockDomain": {
      "additionalProperties": false,
      "properties": {
        "boot_identity_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Boot Identity Sha256",
          "type": "string"
        },
        "clock_domain_identity_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Clock Domain Identity Sha256",
          "type": "string"
        },
        "host_assignment_identity_sha256": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Host Assignment Identity Sha256",
          "type": "string"
        },
        "qpc_frequency_hz": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Qpc Frequency Hz",
          "type": "integer"
        }
      },
      "required": [
        "host_assignment_identity_sha256",
        "boot_identity_sha256",
        "qpc_frequency_hz",
        "clock_domain_identity_sha256"
      ],
      "title": "M6ClockDomain",
      "type": "object"
    },
    "M6ResourceEnvelope": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_events": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Events",
          "type": "integer"
        },
        "max_log_bytes": {
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Max Log Bytes",
          "type": "integer"
        },
        "max_record_bytes": {
          "maximum": 1048576,
          "minimum": 1,
          "title": "Max Record Bytes",
          "type": "integer"
        },
        "max_verifier_backlog_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Max Verifier Backlog Bytes",
          "type": "integer"
        },
        "stop_admission_budget_ticks": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Stop Admission Budget Ticks",
          "type": "integer"
        }
      },
      "required": [
        "max_events",
        "max_record_bytes",
        "max_log_bytes",
        "max_attempts",
        "max_verifier_backlog_bytes",
        "stop_admission_budget_ticks"
      ],
      "title": "M6ResourceEnvelope",
      "type": "object"
    }
  },
  "$id": "urn:disclosure-anchor:operational:m6-owner-anchor.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clock": {
      "$ref": "#/$defs/M6ClockDomain"
    },
    "contract_version": {
      "const": "m6.owner-anchor.v1",
      "default": "m6.owner-anchor.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "deadline_ticks": {
      "exclusiveMinimum": 0,
      "maximum": 9223372036854775807,
      "title": "Deadline Ticks",
      "type": "integer"
    },
    "gpu_device_identity_sha256": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Gpu Device Identity Sha256",
      "type": "string"
    },
    "max_close_ticks": {
      "exclusiveMinimum": 0,
      "maximum": 9223372036854775807,
      "title": "Max Close Ticks",
      "type": "integer"
    },
    "owner_process_epoch_sha256": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Owner Process Epoch Sha256",
      "type": "string"
    },
    "owner_source_sha256": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Owner Source Sha256",
      "type": "string"
    },
    "planned_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 9223372036854775807,
      "title": "Planned Seconds",
      "type": "integer"
    },
    "resources": {
      "$ref": "#/$defs/M6ResourceEnvelope"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x20\\x7f]+$",
      "title": "Run Id",
      "type": "string"
    },
    "t0_ticks": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "T0 Ticks",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "clock",
    "owner_process_epoch_sha256",
    "owner_source_sha256",
    "gpu_device_identity_sha256",
    "t0_ticks",
    "planned_seconds",
    "deadline_ticks",
    "max_close_ticks",
    "resources"
  ],
  "title": "M6OwnerAnchor",
  "type": "object"
}
