# disclosure_anchor service environment template.
#
# Keep real credentials out of repo files. Put local secrets in your shell,
# Keychain, or a private env file outside this checkout.

DISCLOSURE_DATA_ROOT=/Volumes/AgentSSD/agent_system/services/disclosure_anchor
DISCLOSURE_SHARED_ROOT=/Volumes/AgentSSD/agent_system/shared
DISCLOSURE_RUNTIME_ROOT=/Volumes/AgentSSD/agent_system/services/disclosure_anchor/runtime

# Use a private password/env override for local development. Do not commit it.
DATABASE_URL=postgresql+psycopg://disclosure_app:<set-in-private-env>@127.0.0.1:55432/invest_engine
DISCLOSURE_READER_DATABASE_URL=postgresql+psycopg://disclosure_reader:<set-in-private-env>@127.0.0.1:55432/invest_engine
DISCLOSURE_ADMIN_DATABASE_URL=postgresql+psycopg://disclosure_anchor:<set-in-private-env>@127.0.0.1:55432/postgres
DISCLOSURE_MIGRATION_DATABASE_URL=postgresql+psycopg://disclosure_anchor:<set-in-private-env>@127.0.0.1:55432/invest_engine

DISCLOSURE_PGDATA=/Volumes/AgentSSD/agent_system/postgres/pg18-main
DISCLOSURE_PGSOCKET_DIR=/Volumes/AgentSSD/agent_system/postgres/sockets
DISCLOSURE_PGLOG=/Volumes/AgentSSD/agent_system/postgres/logs/disclosure-anchor-pg18.log

MINERU_MODEL_CACHE=/Volumes/AgentSSD/agent_system/shared/model_cache/mineru
HF_HOME=/Volumes/AgentSSD/agent_system/shared/model_cache/huggingface
MODELSCOPE_CACHE=/Volumes/AgentSSD/agent_system/shared/model_cache/modelscope

# Phase 07 CNINFO sync placeholders. Leave unset until CNINFO is in scope.
CNINFO_ACCESS_KEY=<set-in-private-env>
CNINFO_ACCESS_SECRET=<set-in-private-env>
CNINFO_ACCESS_TOKEN=<optional-private-env>

# Phase 08 worker loop (defaults shown; thresholds live in settings, views stay facts-only).
DISCLOSURE_MAX_PARSE_RETRIES=3
DISCLOSURE_MAX_BUILD_RETRIES=3
DISCLOSURE_STALE_RUN_THRESHOLD_SECONDS=3600
DISCLOSURE_SYNC_INTERVAL_SECONDS=86400
DISCLOSURE_INITIAL_LOOKBACK_DAYS=1280
DISCLOSURE_BACKFILL_MAX_PENDING_DOWNLOADS=2000
# 200-stock backfill profile: sync admits at most 13 companies per round and
# the legacy-named cap counts pending-download + downloaded/pending-parse work.
# A GPU outage therefore stops new first-sync admission near the watermark.
WORKER_BATCH_SYNC=13
WORKER_BATCH_DOWNLOAD=50
WORKER_BATCH_PARSE=50
# Sole writer: exact MinerU 3.4.4 Hybrid-medium over the pinned remote runtime.
# The runtime digest is an operator/provider attestation of the immutable image,
# model set, and content-affecting configuration; a mutable tag is not a digest.
DISCLOSURE_MINERU_BACKEND=hybrid-http-client
# Exact executable inside the pinned local MinerU client venv.
DISCLOSURE_MINERU_BIN=/absolute/path/to/mineru-client-venv/bin/mineru
# Mac→dedicated Windows API over a supervised, pinned-host-key SSH forward.
# The API itself is published on Windows loopback only; never use Funnel/LAN.
DISCLOSURE_MINERU_API_URL=http://127.0.0.1:30002
# Mac→vLLM observation/canary/metrics, normally a second SSH LocalForward.
DISCLOSURE_MINERU_OBSERVABILITY_URL=http://127.0.0.1:30001/v1
# Windows API container→vLLM on its dedicated internal Docker network.
DISCLOSURE_MINERU_INFERENCE_UPSTREAM_URL=http://mineru-openai-server:30000/v1
DISCLOSURE_MINERU_API_TASK_SLOTS=1
DISCLOSURE_MINERU_API_INFERENCE_CONCURRENCY=7
DISCLOSURE_MINERU_API_TASK_RETENTION_SECONDS=600
DISCLOSURE_MINERU_API_CLEANUP_INTERVAL_SECONDS=30
DISCLOSURE_MINERU_API_DRAIN_TIMEOUT_SECONDS=86400
# Optional real GPU exporter: NVIDIA DCGM on Linux or pinned nvidia-smi
# exporter on Windows. vLLM /metrics remains separately labelled queue/KV.
DISCLOSURE_GPU_METRICS_URL=http://127.0.0.1:30004/metrics
# Windows exporter deployments pin the one attested GPU; optional for DCGM.
DISCLOSURE_GPU_EXPECTED_UUID=GPU-REPLACE_WITH_ATTESTED_UUID
# Legacy DCGM-only alias; do not configure it to a different URL.
# DISCLOSURE_DCGM_METRICS_URL=https://dcgm.example.invalid/metrics
WORKER_PROGRESS_METRICS_TIMEOUT_SECONDS=5
DISCLOSURE_MINERU_RUNTIME_BUNDLE_IDENTITY_SHA256=sha256:REPLACE_WITH_64_HEX_DIGEST
# New-only private paths written by `make mineru-smoke`; never commit receipts.
DISCLOSURE_MINERU_SMOKE_RECEIPT=/absolute/private/path/mineru-smoke-receipt.v4.json
DISCLOSURE_MINERU_CANARY_CACHE=/absolute/private/path/mineru-canary.v2.json
# New-only PASS from `make mineru-staged-load`; worker verifies it before DB.
DISCLOSURE_MINERU_STAGED_LOAD_RECEIPT=/absolute/private/path/mineru-staged-load-receipt.v6.json
DISCLOSURE_MINERU_STAGED_LOAD_CONFIRMATION_RECEIPT=/absolute/private/path/mineru-staged-load-confirmation-receipt.v6.json
# Canonical identity of the ordered >=16-document real-PDF corpus used by both runs.
DISCLOSURE_MINERU_STAGED_CORPUS_SHA256=sha256:REPLACE_WITH_64_LOWERCASE_HEX
# Calibrate from the current Docker Desktop VM; example is a 4 GiB reserve.
DISCLOSURE_MINERU_DOCKER_MEMORY_RESERVE_BYTES=4294967296
# Static smoke/staged-load proof is a startup lease; the resident process then
# performs live model/API probes every 300s.  Thirty days covers one backfill
# campaign while every new process composition still fails closed on expiry.
DISCLOSURE_MINERU_CANARY_MAX_AGE_SECONDS=2592000
# Production remote-GPU profile. The writer rejects local/VLM/High alternatives.
WORKER_PARSE_CONCURRENCY=16
WORKER_MINERU_CLIENT_OUTSTANDING_WINDOW=1
# Current 30 GiB Docker profile is 1 task slot × service-side VLM 7.
# Local candidate threads may wait, but only one whole PDF may be submitted to
# the non-cancellable remote API at a time; PostgreSQL keeps the durable backlog.
WORKER_GPU_REQUEST_BUDGET=7
WORKER_GPU_MAX_SEQUENCES=128
# Saturated mixed-queue shares. Capacity is borrowed when a lane is empty;
# PDFs remain whole documents, preserving cross-page tables/reading order.
WORKER_PARSE_HEAVY_PAGE_THRESHOLD=80
WORKER_PARSE_HEAVY_SATURATED_SHARE=4
WORKER_PARSE_HUGE_PAGE_THRESHOLD=500
WORKER_PARSE_HUGE_SATURATED_SHARE=1
WORKER_PARSE_CANDIDATE_WINDOW=1000
WORKER_FINALIZE_CONCURRENCY=2
# Closed-vocabulary Unit route adjudicator.  Model and effort are receipt/cache
# identity, so operators can change them without changing business code or
# reusing decisions from a different configuration.  Prefer an absolute CLI
# path in the machine-local worker.env used by launchd.
DISCLOSURE_SEMANTIC_CODEX_BIN=/absolute/path/to/codex
DISCLOSURE_SEMANTIC_MODEL=gpt-5.6-luna
DISCLOSURE_SEMANTIC_REASONING_EFFORT=low
DISCLOSURE_SEMANTIC_TIMEOUT_SECONDS=600
DISCLOSURE_SEMANTIC_BATCH_SIZE=16
# Soft expected-duration envelope = min(max, max(base, pages * per-page)).
# Exceeding it warns but does not terminate a healthy whole-document parse.
DISCLOSURE_PARSE_TIMEOUT_SECONDS=3600
DISCLOSURE_PARSE_TIMEOUT_PER_PAGE_SECONDS=12
DISCLOSURE_PARSE_TIMEOUT_MAX_SECONDS=14400
# Last-resort live-but-stuck process guard; not a normal document SLA.
DISCLOSURE_PARSE_RUNAWAY_TIMEOUT_SECONDS=86400
# MinerU server-side window; keep at 16 (round22h OOM ceiling).
MINERU_PROCESSING_WINDOW_SIZE=16
# Resident admission re-checks the exact served model at this cadence.
DISCLOSURE_MINERU_LIVE_PROBE_INTERVAL_SECONDS=300
WORKER_BATCH_BUILD=10
WORKER_BATCH_PUBLISH=10
# Observation-only snapshot cadence for the continuous resident dispatcher.
# It never closes admission or drains parse/finalize futures.
WORKER_REPORT_INTERVAL_SECONDS=300
WORKER_LOOP_INTERVAL_SECONDS=900
WORKER_LOOP_MAX_INTERVAL_SECONDS=1800
