# disclosure_anchor service environment template.
#
# Keep real credentials out of repo files. Put local secrets in your shell,
# Keychain, or a private env file outside this checkout.

DISCLOSURE_DATA_ROOT=/Volumes/AgentSSD/agent_system/services/disclosure_anchor
DISCLOSURE_SHARED_ROOT=/Volumes/AgentSSD/agent_system/shared
DISCLOSURE_RUNTIME_ROOT=/Volumes/AgentSSD/agent_system/services/disclosure_anchor/runtime

# Use a private password/env override for local development. Do not commit it.
DATABASE_URL=postgresql+psycopg://disclosure_anchor:<set-in-private-env>@127.0.0.1:55432/invest_engine
DISCLOSURE_READER_DATABASE_URL=postgresql+psycopg://disclosure_reader:<set-in-private-env>@127.0.0.1:55432/invest_engine
DISCLOSURE_ADMIN_DATABASE_URL=postgresql+psycopg://disclosure_anchor:<set-in-private-env>@127.0.0.1:55432/postgres
DISCLOSURE_MIGRATION_DATABASE_URL=postgresql+psycopg://disclosure_anchor:<set-in-private-env>@127.0.0.1:55432/invest_engine

DISCLOSURE_PGDATA=/Volumes/AgentSSD/agent_system/postgres/pg18-main
DISCLOSURE_PGSOCKET_DIR=/Volumes/AgentSSD/agent_system/postgres/sockets
DISCLOSURE_PGLOG=/Volumes/AgentSSD/agent_system/postgres/logs/disclosure-anchor-pg18.log

MINERU_MODEL_CACHE=/Volumes/AgentSSD/agent_system/shared/model_cache/mineru
HF_HOME=/Volumes/AgentSSD/agent_system/shared/model_cache/huggingface
MODELSCOPE_CACHE=/Volumes/AgentSSD/agent_system/shared/model_cache/modelscope

# Phase 07 CNINFO sync placeholders. Leave unset until CNINFO is in scope.
CNINFO_ACCESS_KEY=<set-in-private-env>
CNINFO_ACCESS_SECRET=<set-in-private-env>
CNINFO_ACCESS_TOKEN=<optional-private-env>

# Phase 08 worker loop (defaults shown; thresholds live in settings, views stay facts-only).
DISCLOSURE_MAX_PARSE_RETRIES=3
DISCLOSURE_MAX_BUILD_RETRIES=3
DISCLOSURE_STALE_RUN_THRESHOLD_SECONDS=3600
DISCLOSURE_SYNC_INTERVAL_SECONDS=86400
DISCLOSURE_BACKFILL_MAX_PENDING_DOWNLOADS=2000
# 200-stock backfill profile: sync admits at most 13 companies per round and
# the legacy-named cap counts pending-download + downloaded/pending-parse work.
# A GPU outage therefore stops new first-sync admission near the watermark.
WORKER_BATCH_SYNC=13
WORKER_BATCH_DOWNLOAD=50
WORKER_BATCH_PARSE=50
# Safe local default. Raise to 8 only together with a *-http-client backend
# and DISCLOSURE_MINERU_SERVER_URL; settings rejects unsafe local parallelism.
WORKER_PARSE_CONCURRENCY=1
# MinerU server-side window; keep at 16 (round22h OOM ceiling).
MINERU_PROCESSING_WINDOW_SIZE=16
WORKER_BATCH_BUILD=10
WORKER_BATCH_PUBLISH=10
WORKER_LOOP_INTERVAL_SECONDS=900
WORKER_LOOP_MAX_INTERVAL_SECONDS=1800
