# Copy to ~/.config/agent-invest/disclosure_anchor/mineru-tunnel.env, replace
# paths if needed, and chmod 0600. This file contains no passwords; the private
# key and the single-line pinned known_hosts file must also be mode 0600.
MINERU_SSH_HOST=100.64.0.1
MINERU_SSH_USER=replace_with_restricted_tunnel_user
MINERU_SSH_PORT=22
MINERU_SSH_IDENTITY_FILE=/Users/replace/.ssh/agentinvest_mineru_tunnel_ed25519
MINERU_SSH_KNOWN_HOSTS_FILE=/Users/replace/.config/agent-invest/disclosure_anchor/mineru-known-hosts
