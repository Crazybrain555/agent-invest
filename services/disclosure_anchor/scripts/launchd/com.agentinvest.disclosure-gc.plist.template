<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agentinvest.disclosure-gc</string>
  <!-- Daily orphan-only derived-artifact collection at 19:30 (after the
       18:30 doctor sweep). Processing runs and public history are retained. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/scripts/gc_daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>19</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/agent-invest/disclosure-gc.out</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/agent-invest/disclosure-gc.err</string>
</dict>
</plist>
