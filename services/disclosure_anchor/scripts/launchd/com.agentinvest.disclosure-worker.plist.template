<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agentinvest.disclosure-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/scripts/run_worker_once.sh</string>
    <string>loop</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <!-- Allow the wrapper to forward SIGTERM and reap MinerU process groups
       before launchd escalates to SIGKILL. -->
  <key>ExitTimeOut</key><integer>90</integer>
  <!-- launchd stdout/err MUST live on the internal disk (~/Library/Logs is
       the macOS LaunchAgent convention): creating files on an external
       volume from a launchd-spawned process is TCC-denied with no prompt,
       and the job dies as EX_CONFIG before the script even runs (observed
       2026-07-08). The script appends the real worker log under
       $DISCLOSURE_RUNTIME_ROOT once it is running. -->
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/agent-invest/disclosure-worker.out</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/agent-invest/disclosure-worker.err</string>
</dict>
</plist>
